# Copy to .env or set these environment variables in your shell.
# MUST be a long random secret; do not commit the real value.
AGENT_TOKEN=replace_with_a_long_random_secret
A2A_BASE_URL=https://your-public-host.example/a2a

# Local Ollama OpenAI-compatible endpoint (default):
MODEL_PROVIDER=ollama
MODEL_NAME=qwen2.5:3b
MODEL_URL=http://localhost:11434/v1/chat/completions
MODEL_API_KEY=

# For a hosted OpenAI-compatible provider, set MODEL_URL, MODEL_NAME, MODEL_API_KEY.
# If using multiple principals, set AUTH_TOKEN_MAP=token1=user1,token2=user2
DB_PATH=invoice_agent.sqlite3
